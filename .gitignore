# ============================================================
# 全局 .gitignore(放在 repo 根目录)
# ============================================================
# git 的 ignore 模式默认递归匹配所有子目录,
# 所以这里的规则对 promptfoo/use_cases/dify-eval/ 等子目录同样生效。
# ============================================================

# ---- promptfoo 运行产物 ----
_result.json
_run.log
result_test.json
promptfoo_results.json
promptfoo_results.html
promptfoo_run.log
*.log

# ---- promptfoo 缓存 ----
.promptfoo/
.cache/

# ---- 环境变量(含真实密钥,勿提交;.env.example 可提交作为模板) ----
.env
.env.local
.env.*.local

# ---- Node ----
node_modules/
package-lock.json

# ---- 系统/编辑器 ----
.DS_Store
Thumbs.db
.vscode/
.idea/
