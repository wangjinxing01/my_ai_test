// ============================================================
// Dify 动物图片识别工作流 - promptfoo 测试流水线
// ============================================================
// 触发方式：手动 / 定时(每晚23:00) / Git提交
// 运行环境：Windows + Jenkins (wangj 账号)
// ============================================================

pipeline {
    agent any

    triggers {
        cron('H 23 * * *')
    }

    environment {
        OPENAI_API_KEY = credentials('promptfoo-glm-apikey')
        DIFY_API_KEY   = credentials('dify-apikey')
        DIFY_BASE_URL  = 'http://dify.mycompany.com:5001/v1'
        DIFY_USER      = 'abc-123'
    }

    options {
        timestamps()
        timeout(time: 30, unit: 'MINUTES')
        buildDiscarder(logRotator(numToKeepStr: '20'))
    }

    stages {
        stage('环境诊断') {
            steps {
                echo '== 打印环境信息 =='
                // 用 @ 而非默认输出，避免某些命令卡住
                bat '@echo OFF & echo WHOAMI: & whoami & echo. & echo NODE: & node --version & echo. & echo PATH: & echo %PATH%'
            }
        }

        stage('定位 promptfoo') {
            steps {
                echo '== 查找 promptfoo 入口 =='
                // 直接判断文件是否存在，不用 where（避免卡住）
                bat '''
                    @echo OFF
                    set PROMPTFOO_JS=%APPDATA%\\npm\\node_modules\\promptfoo\\dist\\src\\entrypoint.js
                    if exist "%PROMPTFOO_JS%" (
                        echo FOUND: %PROMPTFOO_JS%
                        echo VERSION:
                        node "%PROMPTFOO_JS%" --version
                    ) else (
                        echo NOT FOUND at %PROMPTFOO_JS%
                        echo APPDATA=%APPDATA%
                        exit /b 1
                    )
                '''
            }
        }

        stage('运行 promptfoo 评测') {
            steps {
                echo '== 执行 promptfoo eval =='
                // 生成 .env 文件供 promptfoo 读取
                writeFile file: '.env', text: """DIFY_BASE_URL=${DIFY_BASE_URL}
DIFY_API_KEY=${DIFY_API_KEY}
DIFY_USER=${DIFY_USER}
OPENAI_API_KEY=${OPENAI_API_KEY}"""

                // 串行执行(-j 1)避免 Dify 模型限流(429)
                // 用 node 直调入口 JS，不依赖 promptfoo 命令是否在 PATH
                bat '''
                    @echo OFF
                    set PROMPTFOO_JS=%APPDATA%\\npm\\node_modules\\promptfoo\\dist\\src\\entrypoint.js
                    node "%PROMPTFOO_JS%" eval -j 1 --env-file .env -o promptfoo_results.json -o promptfoo_results.html --no-cache
                '''
            }
        }
    }

    post {
        always {
            echo '== 清理临时 .env =='
            bat 'if exist .env del .env'

            echo '== 归档产物 =='
            archiveArtifacts artifacts: 'promptfoo_results.json, promptfoo_results.html', allowEmptyArchive: true

            publishHTML(target: [
                reportDir: '.',
                reportFiles: 'promptfoo_results.html',
                reportName: 'Promptfoo Report',
                keepAll: true,
                alwaysLinkToLastBuild: true,
                allowMissing: true
            ])

            script {
                if (fileExists('promptfoo_results.json')) {
                    def results = readJSON file: 'promptfoo_results.json'
                    def fails = 0
                    if (results.results) {
                        for (r in results.results) {
                            if (r.success == false) {
                                fails++
                            }
                        }
                    }
                    echo "Done. Failed cases: ${fails}"
                    if (fails > 0) {
                        currentBuild.result = 'UNSTABLE'
                    }
                }
            }
        }
    }
}
