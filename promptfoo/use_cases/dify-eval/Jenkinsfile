// ============================================================
// Dify 动物图片识别工作流 - promptfoo 测试流水线
// ============================================================
// 触发方式：手动 / 定时(每晚23:00) / Git提交
// 运行环境：Windows + Jenkins (wangj 账号)
// ============================================================

pipeline {
    agent any

    triggers {
        cron('H 23 * * *')
    }

    environment {
        DIFY_BASE_URL  = 'http://dify.mycompany.com:5001/v1'
        DIFY_USER      = 'abc-123'
    }

    options {
        timestamps()
        timeout(time: 30, unit: 'MINUTES')
        buildDiscarder(logRotator(numToKeepStr: '20'))
    }

    stages {
        stage('环境诊断') {
            steps {
                echo '== 打印环境信息 =='
                bat '@echo OFF & echo WHOAMI: & whoami & echo. & echo NODE: & node --version & echo. & echo PATH: & echo %PATH%'
            }
        }

        stage('定位 promptfoo') {
            steps {
                echo '== 查找 promptfoo 入口 =='
                bat '''
                    @echo OFF
                    set PROMPTFOO_JS=%APPDATA%\\npm\\node_modules\\promptfoo\\dist\\src\\entrypoint.js
                    if exist "%PROMPTFOO_JS%" (
                        echo FOUND: %PROMPTFOO_JS%
                        echo VERSION:
                        node "%PROMPTFOO_JS%" --version
                    ) else (
                        echo NOT FOUND at %PROMPTFOO_JS%
                        echo APPDATA=%APPDATA%
                        exit /b 1
                    )
                '''
            }
        }

        stage('运行 promptfoo 评测') {
            steps {
                echo '== 执行 promptfoo eval =='
                // 用 withCredentials 显式绑定,避免 Groovy 字符串插值把 secret mask 成 ****
                withCredentials([
                    string(credentialsId: 'promptfoo-glm-apikey', variable: 'GLM_KEY'),
                    string(credentialsId: 'dify-apikey', variable: 'DIFY_KEY')
                ]) {
                    dir('promptfoo/use_cases/dify-eval') {
                        // 生成 .env 文件:用 withCredentials 绑定的 %VAR% 写入
                        // 每行单独 echo > (避免 cmd 续行符 ^ 在重定向时出问题)
                        bat '''
                            @echo OFF
                            echo DIFY_BASE_URL=%DIFY_BASE_URL% > .env
                            echo DIFY_API_KEY=%DIFY_KEY% >> .env
                            echo DIFY_USER=%DIFY_USER% >> .env
                            echo OPENAI_API_KEY=%GLM_KEY% >> .env
                            echo .env content:
                            type .env
                        '''

                        // 串行执行(-j 1)避免 Dify 模型限流(429)
                        bat '''
                            @echo OFF
                            set PROMPTFOO_JS=%APPDATA%\\npm\\node_modules\\promptfoo\\dist\\src\\entrypoint.js
                            node "%PROMPTFOO_JS%" eval -j 1 --env-file .env -o promptfoo_results.json -o promptfoo_results.html --no-cache
                        '''
                    }
                }
            }
        }
    }

    post {
        always {
            echo '== 清理临时 .env =='
            bat 'if exist promptfoo\\use_cases\\dify-eval\\.env del promptfoo\\use_cases\\dify-eval\\.env'

            echo '== 归档产物 =='
            archiveArtifacts artifacts: 'promptfoo/use_cases/dify-eval/promptfoo_results.json, promptfoo/use_cases/dify-eval/promptfoo_results.html', allowEmptyArchive: true

            publishHTML(target: [
                reportDir: 'promptfoo/use_cases/dify-eval',
                reportFiles: 'promptfoo_results.html',
                reportName: 'Promptfoo Report',
                keepAll: true,
                alwaysLinkToLastBuild: true,
                allowMissing: true
            ])

            // 用 findstr 判断失败用例(不依赖 readJSON 插件)
            // promptfoo_results.json 里 "success": false 表示失败用例
            script {
                if (fileExists('promptfoo/use_cases/dify-eval/promptfoo_results.json')) {
                    echo '== 检查失败用例 =='
                    def failCheck = bat(returnStdout: true, script: '''
                        @echo OFF
                        findstr /C:"\"success\":false" "promptfoo\\use_cases\\dify-eval\\promptfoo_results.json" | find /C /V ""
                    ''').trim()
                    echo "Failed cases (raw): ${failCheck}"
                    try {
                        def fails = failCheck.toInteger()
                        echo "评测完成,失败用例数: ${fails}"
                        if (fails > 0) {
                            currentBuild.result = 'UNSTABLE'
                        }
                    } catch (Exception e) {
                        echo "无法解析失败数,跳过门禁判断"
                    }
                } else {
                    echo '结果文件不存在,跳过门禁判断'
                }
            }
        }
    }
}
