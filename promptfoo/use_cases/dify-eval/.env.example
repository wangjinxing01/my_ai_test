# ============================================================
# promptfoo 环境变量模板
# ============================================================
# 用法：
#   1. 复制本文件为 .env
#   2. 填入真实密钥
#   3. 运行：promptfoo eval --env-file .env
#
# 注意：.env 文件不要提交到 Git（已在 .gitignore 中忽略）
# ============================================================

# ---- Dify 工作流 API ----
DIFY_BASE_URL=http://dify.mycompany.com:5001/v1
DIFY_API_KEY=app-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
DIFY_USER=abc-123

# ---- 断言模型：智谱 GLM ----
# promptfoo 的 openai provider 默认读取 OPENAI_API_KEY
OPENAI_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxx.xxxxxxxxxxxxxxxx
